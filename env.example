# Zendesk
ZENDESK_ENV=sandbox                        # "sandbox" | "production" — never flip to production without sign-off
ZD_OAUTH_TOKEN=                            # Zendesk OAuth Bearer token — never commit real value
                                           # Brady: confirm token refresh strategy — OAuth tokens expire
ZD_LINEAR_FIELD_ID=55650874801043          # Numeric ID of the "Linear Issue" custom field in Zendesk

# Linear
LINEAR_API_TOKEN=                          # Linear service account API token — must NOT be a personal token
                                           # Brady: provision a dedicated Aether service account in Linear

# Slack
SLACK_BOT_TOKEN=                           # Slack bot token for posting to #feedback-releases and #support-releases
SLACK_FEEDBACK_CHANNEL=#feedback-releases  # Channel for P1 alerts + P1/P2
